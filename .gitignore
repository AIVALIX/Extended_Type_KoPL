# =============================================================================
# Datasets — broadly ignored, with selective inclusion for publication.
# Heavy raw graphs (e.g., PrimeKG ~500MB) are obtained per-user via the
# instructions in README; only Neo4j-import-ready CSVs are shipped.
# Patterns are anchored to repo root with leading slash so that nested
# data/ directories (e.g., app/data/) remain ignored separately.
# =============================================================================
/data/
!/data/
/data/*
!/data/metaqa
!/data/metaqa/**
!/data/primekgqa
/data/primekgqa/*
!/data/primekgqa/import_nodes.csv
!/data/pcqa
/data/pcqa/*
!/data/pcqa/PcQA.json
!/data/pcqa/README.md
!/data/pcqa/import_nodes.csv
!/data/pcqa/import_rels.csv
!/data/pcqa/build_eval_cypher.py
!/data/pcqa/manual_entity_fixes.json
!/data/pcqa/entity_mappings.json
!/data/pcqa/sample_categories.json
!/data/pcqa/qa
/data/pcqa/qa/*
!/data/pcqa/qa/eval_v2.jsonl
!/data/pcqa/qa/eval_v3.jsonl

# Nested data/ inside app/ is dev-only
app/data/

# =============================================================================
# Evaluation outputs
# =============================================================================
result/
metaqa_results/
metaqa_results_100/
metaqa_results_1000/
app/result/
*./output

# =============================================================================
# Internal reports & manuscript / experiment scripts (not for publication)
# Manuscript is released via Springer / arXiv; reproduction shell scripts
# are kept local for development only.
# =============================================================================
report/
app/Report/
docs/
scripts/

# =============================================================================
# App scratch / experiments / backup files
# =============================================================================
app/experiments/
app/__pycache__/
app/pipeline/extended_type_kopl/pipeline.py.bak
app/pipeline/extended_type_kopl/pipeline.py.current
app/pipeline/extended_type_kopl/pipeline.py.current2

# =============================================================================
# Dataset construction — broadly ignored, only the PrimeKGQA-original
# converter is shipped (raw PrimeKGQA-original is obtained per README).
# =============================================================================
app/dataset_construction/
!app/dataset_construction/
app/dataset_construction/*
!app/dataset_construction/__init__.py
!app/dataset_construction/convert_primekgqa_original.py

# =============================================================================
# LaTeX build artifacts (PDFs kept tracked for reader convenience)
# =============================================================================
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.tex.bak
docs/paper_latex/llncs.zip
docs/paper_latex/llncs/
docs/paper_latex/test_compile.*
